#!/bin/sh
# neovida-transcribe: видео и аудио в текст на русском, локально (GigaAM v3). NEOVIDA, AI Цех.
# Лежит в ~/.local/bin. Запускает скрипт из ~/.neovida-transcribe его собственным Python
# (папка venv), поэтому работает без интернета и внутри песочницы агента.
DIR="$HOME/.neovida-transcribe"
PY="$DIR/venv/bin/python"
if [ ! -x "$PY" ] || [ ! -f "$DIR/neovida_transcribe.py" ]; then
  echo "Ошибка: neovida-transcribe установлен не до конца. Инструкция: https://materials.neovida.ai/ai-tseh/potok-4/transcribe/SETUP.md" >&2
  exit 1
fi
exec "$PY" "$DIR/neovida_transcribe.py" "$@"
